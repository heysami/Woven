  "entries": {
    "bokeh-blur": {
      "name": "Bokeh Blur (depth-of-field highlight bloom)",
      "category": "image-effect",
      "family": "filter",
      "defaultBlend": "normal",
      "animated": "yes",
      "needsSource": "yes",
      "stackable": "yes",
      "subCategory": "light",
      "role": "overlay",
      "roleAffinity": [
        "overlay"
      ],
      "oneLine": "Soft lens blur where the bright spots bloom into rounded bokeh discs - the Figma `Bokeh blur` effect, with controls for highlight density. Dreamy depth-of-field, festive light backdrops, premium product haze.",
      "notForUseWhen": "crisp technical diagrams, dense tables",
      "pairsPrototypes": [
        "aesthetic-luxury-cinematic-dark",
        "recipe-bento-marketing",
        "aesthetic-frutiger-aero",
        "recipe-aurora-marketing"
      ],
      "sourceFile": "design-library/shader-bokeh-blur.md"
    },
    "channel-mixer": {
      "name": "Channel Mixer (false-color / duotone channel remap)",
      "category": "image-effect",
      "family": "filter",
      "defaultBlend": "normal",
      "animated": "no",
      "needsSource": "yes",
      "stackable": "yes",
      "subCategory": "color",
      "role": "overlay",
      "roleAffinity": [
        "overlay"
      ],
      "oneLine": "Rebuild each output channel as a weighted mix of the source's R/G/B - the Figma `Channel mixer` effect. Custom color treatments, false-color infrared looks, surgical duotones, thermal palettes. A 3x3 (or 3x4) matrix on the pixels beneath.",
      "notForUseWhen": "brand photos needing true color",
      "pairsPrototypes": [
        "aesthetic-monochrome-pop-poster",
        "aesthetic-cyberpunk",
        "recipe-editorial-magazine",
        "aesthetic-acid-graphics"
      ],
      "sourceFile": "design-library/shader-channel-mixer.md"
    },
    "chromatic-metal": {
      "name": "Chromatic Metal (inflated glossy metal + RGB separation)",
      "category": "image-effect",
      "family": "filter",
      "defaultBlend": "normal",
      "animated": "yes",
      "needsSource": "yes",
      "stackable": "yes",
      "subCategory": "metal",
      "role": "overlay",
      "roleAffinity": [
        "overlay"
      ],
      "oneLine": "Give shapes and type a glossy, inflated liquid-metal finish with RGB channel separation at the highlights - the Figma `Chromatic metal` effect. Y2K chrome, bubble-text, iridescent fluid foil. Inflates the layer's alpha into a rounded body, then lights it like chrome.",
      "notForUseWhen": "matte editorial, flat utilitarian UI",
      "pairsPrototypes": [
        "aesthetic-y2k-futurism",
        "aesthetic-urbling",
        "aesthetic-cyberpunk",
        "style-holographic"
      ],
      "sourceFile": "design-library/shader-chromatic-metal.md"
    },
    "clouds": {
      "name": "Clouds (procedural turbulent cloud texture)",
      "category": "generative-fill",
      "family": "source",
      "defaultBlend": "normal",
      "animated": "yes",
      "needsSource": "no",
      "stackable": "yes",
      "subCategory": "noise",
      "role": "background",
      "roleAffinity": [
        "background"
      ],
      "oneLine": "Soft, billowing procedural clouds with customizable colors and turbulence - the Figma `Clouds` fill. Frutiger-Aero skies, dream-soft backdrops, drifting fog. Domain-warped fbm shaped into puffs with a sky gradient behind.",
      "notForUseWhen": "hard tech UI, dense dashboards",
      "pairsPrototypes": [
        "aesthetic-solarpunk",
        "aesthetic-coastal-grandmother",
        "aesthetic-frutiger-aero",
        "aesthetic-dreamcore"
      ],
      "sourceFile": "design-library/shader-clouds.md"
    },
    "color-outline": {
      "name": "Color Outline (stacked offset outlines + gradient edge line-art)",
      "category": "image-effect",
      "family": "filter",
      "defaultBlend": "screen",
      "animated": "no",
      "needsSource": "yes",
      "stackable": "yes",
      "subCategory": "edge",
      "role": "overlay",
      "roleAffinity": [
        "overlay"
      ],
      "oneLine": "Detect the layer's edges and re-draw them as crisp colored contour lines - one outline, or a stack of concentric offset outlines in shifting hues (the Figma `Outlines` + `Colored edges` effects). Turns any image or shape into vibrant poster line-art.",
      "notForUseWhen": "photoreal product, subtle luxury",
      "pairsPrototypes": [
        "aesthetic-acid-design",
        "aesthetic-neubrutalism",
        "aesthetic-monochrome-pop-poster",
        "aesthetic-y2k-memphis-loud"
      ],
      "sourceFile": "design-library/shader-color-outline.md"
    },
    "concentric-patterns": {
      "name": "Concentric Patterns (bold nested ring shapes)",
      "category": "generative-fill",
      "family": "source",
      "defaultBlend": "normal",
      "animated": "yes",
      "needsSource": "no",
      "stackable": "yes",
      "subCategory": "screen-pattern",
      "role": "background",
      "roleAffinity": [
        "background"
      ],
      "oneLine": "Bold concentric rings / nested shapes radiating from a center, customizable shape and spacing - the Figma `Concentric patterns` fill. Op-art targets, retro sunbursts, hypnotic rings that can pulse outward.",
      "notForUseWhen": "minimal restrained SaaS, photoreal hero",
      "pairsPrototypes": [
        "aesthetic-op-art",
        "aesthetic-y2k-memphis-loud",
        "aesthetic-acid-design"
      ],
      "sourceFile": "design-library/shader-concentric-patterns.md"
    },
    "dither-waves": {
      "name": "Dither Waves (luminous wave bands, error-diffusion screen)",
      "category": "generative-fill",
      "family": "source",
      "defaultBlend": "screen",
      "animated": "yes",
      "needsSource": "no",
      "stackable": "yes",
      "subCategory": "screen-pattern",
      "role": "background",
      "roleAffinity": [
        "background"
      ],
      "oneLine": "Smooth luminous sine-bands of light advected across the frame, then quantized through an ordered (Bayer) or error-diffusion (Floyd-Steinberg / Atkinson) dither so the gradient breaks into a living grid of 1-bit / 2-bit pixels. The Figma `Glowing wave` fill run through the `Dither` effect - retro-CRT light that never bands.",
      "notForUseWhen": "flat clean SaaS, photographic hero",
      "pairsPrototypes": [
        "aesthetic-cyberpunk",
        "aesthetic-cassette-futurism",
        "recipe-ai-foundry-dark",
        "aesthetic-y2k-futurism"
      ],
      "sourceFile": "design-library/shader-dither-waves.md"
    },
    "dither": {
      "name": "Dither (Atkinson / Floyd-Steinberg / Bayer screen)",
      "category": "image-effect",
      "family": "filter",
      "defaultBlend": "normal",
      "animated": "no",
      "needsSource": "yes",
      "stackable": "yes",
      "subCategory": "screen-pattern",
      "role": "overlay",
      "roleAffinity": [
        "overlay"
      ],
      "oneLine": "Stylized dithering of the layer beneath using the classic algorithms - Atkinson, Floyd-Steinberg, ordered Bayer - quantizing it to 1-bit / 2-bit / a small palette. The Figma `Dither` effect: the standalone screen you drop on ANY layer (the filter twin of `dither-waves`).",
      "notForUseWhen": "smooth premium gradients, photoreal hero",
      "pairsPrototypes": [
        "aesthetic-8-bit-generic",
        "style-pixel-bitmap",
        "aesthetic-cassette-futurism",
        "aesthetic-monochrome-pop-poster"
      ],
      "sourceFile": "design-library/shader-dither.md"
    },
    "fluid-halftone": {
      "name": "Fluid Halftone (advected ink re-screened as dots)",
      "category": "generative-fill",
      "family": "source",
      "defaultBlend": "multiply",
      "animated": "yes",
      "needsSource": "no",
      "stackable": "yes",
      "subCategory": "halftone",
      "role": "background",
      "roleAffinity": [
        "background"
      ],
      "oneLine": "A slow curl-noise fluid field (ink swirling in water) sampled through a rotated halftone dot grid, so the flowing density resolves into CMYK-style print dots that grow and shrink as the fluid moves. Print-press texture that is alive.",
      "notForUseWhen": "minimal corporate, dense data UI",
      "pairsPrototypes": [
        "aesthetic-acid-graphics",
        "aesthetic-y2k-memphis-loud",
        "recipe-editorial-magazine",
        "aesthetic-vaporwave"
      ],
      "sourceFile": "design-library/shader-fluid-halftone.md"
    },
    "fractal-noise": {
      "name": "Fractal Noise (Perlin / Value / Voronoise procedural fill)",
      "category": "generative-fill",
      "family": "source",
      "defaultBlend": "overlay",
      "animated": "yes",
      "needsSource": "no",
      "stackable": "yes",
      "subCategory": "noise",
      "role": "background",
      "roleAffinity": [
        "background"
      ],
      "oneLine": "The raw procedural noise fill - Perlin, Value, or Voronoise fbm - the Figma `Fractal noise` fill and the substrate under half the effects in this library. Clouds, smoke, organic grain, and the displacement source other shaders sample.",
      "notForUseWhen": "crisp flat UI, hard-edged poster",
      "pairsPrototypes": [
        "recipe-ai-foundry-dark",
        "aesthetic-dark-botanical-maximalism",
        "aesthetic-cosmic-horizon",
        "aesthetic-cottagegoth"
      ],
      "sourceFile": "design-library/shader-fractal-noise.md"
    },
    "glowing-wave": {
      "name": "Glowing Wave (luminous wave fill, on-canvas glow)",
      "category": "generative-fill",
      "family": "source",
      "defaultBlend": "screen",
      "animated": "yes",
      "needsSource": "no",
      "stackable": "yes",
      "subCategory": "light",
      "role": "background",
      "roleAffinity": [
        "background"
      ],
      "oneLine": "Smooth bands of emitted light undulating across the frame with on-canvas controls for color, glow and motion - the Figma `Glowing wave` fill. The clean luminous source BEFORE any dither; feed it into `dither` for the retro-CRT variant.",
      "notForUseWhen": "flat corporate, dense data tables",
      "pairsPrototypes": [
        "aesthetic-cyberpunk",
        "recipe-ai-foundry-dark",
        "aesthetic-cassette-futurism",
        "aesthetic-cosmic-horizon"
      ],
      "sourceFile": "design-library/shader-glowing-wave.md"
    },
    "godrays": {
      "name": "Godrays (volumetric light shafts from a source)",
      "category": "generative-fill",
      "family": "source",
      "defaultBlend": "add",
      "animated": "yes",
      "needsSource": "no",
      "stackable": "yes",
      "subCategory": "light",
      "role": "overlay",
      "roleAffinity": [
        "overlay"
      ],
      "oneLine": "Volumetric light shafts (crepuscular rays) streaming from one origin point through unseen haze - the radial bloom that makes a dark scene feel lit from within. paper-design's `godRays`: light as a material.",
      "notForUseWhen": "flat utilitarian UI, bright airy brands",
      "pairsPrototypes": [
        "aesthetic-luxury-cinematic-dark",
        "aesthetic-cosmic-horizon",
        "aesthetic-bioluminescent-deep",
        "aesthetic-solarpunk"
      ],
      "sourceFile": "design-library/shader-godrays.md"
    },
    "gradient-map": {
      "name": "Gradient Map (luminance remapped to a custom color ramp)",
      "category": "image-effect",
      "family": "filter",
      "defaultBlend": "normal",
      "animated": "no",
      "needsSource": "yes",
      "stackable": "yes",
      "subCategory": "color",
      "role": "overlay",
      "roleAffinity": [
        "overlay"
      ],
      "oneLine": "Throw away the layer's hue and remap its LUMINANCE to a custom gradient - shadows take one color, highlights another, midtones the stops between. The Figma `Gradient map` effect: the single most powerful one-move way to force any image onto a brand palette (duotone / tritone).",
      "notForUseWhen": "brand photos that must keep true color",
      "pairsPrototypes": [
        "aesthetic-monochrome-pop-poster",
        "aesthetic-luxury-cinematic-dark",
        "recipe-editorial-magazine",
        "aesthetic-acid-graphics"
      ],
      "sourceFile": "design-library/shader-gradient-map.md"
    },
    "halftone": {
      "name": "Halftone (vintage print / comic dot screen)",
      "category": "image-effect",
      "family": "filter",
      "defaultBlend": "multiply",
      "animated": "no",
      "needsSource": "yes",
      "stackable": "yes",
      "subCategory": "halftone",
      "role": "overlay",
      "roleAffinity": [
        "overlay"
      ],
      "oneLine": "Re-screen the layer beneath as vintage print / comic-book halftone - a rotated grid of dots whose size tracks luminance, with controls for color separation and dot size. The Figma `Halftone` effect: the static filter twin of `fluid-halftone`.",
      "notForUseWhen": "smooth gradient hero, photoreal product",
      "pairsPrototypes": [
        "recipe-editorial-magazine",
        "aesthetic-y2k-memphis-loud",
        "aesthetic-anti-design",
        "aesthetic-monochrome-pop-poster"
      ],
      "sourceFile": "design-library/shader-halftone.md"
    },
    "hatching": {
      "name": "Hatching (cross-hatch line shading from luminance)",
      "category": "image-effect",
      "family": "filter",
      "defaultBlend": "multiply",
      "animated": "no",
      "needsSource": "yes",
      "stackable": "yes",
      "subCategory": "edge",
      "role": "overlay",
      "roleAffinity": [
        "overlay"
      ],
      "oneLine": "Shade the layer beneath with engraving-style cross-hatching - darker tones get denser, more-crossed line layers, exactly like pen-and-ink or a banknote engraving. The Figma `Hatching` effect for text, shapes and images.",
      "notForUseWhen": "glossy modern SaaS, vibrant pop",
      "pairsPrototypes": [
        "recipe-editorial-magazine",
        "aesthetic-dark-academia",
        "style-doodle",
        "recipe-newspaper-of-record"
      ],
      "sourceFile": "design-library/shader-hatching.md"
    },
    "lens-distortion": {
      "name": "Lens Distortion (barrel/pincushion + radial chromatic aberration)",
      "category": "image-effect",
      "family": "filter",
      "defaultBlend": "normal",
      "animated": "no",
      "needsSource": "yes",
      "stackable": "yes",
      "subCategory": "distortion",
      "role": "overlay",
      "roleAffinity": [
        "overlay"
      ],
      "oneLine": "Optical lens warp - barrel (bulge) or pincushion (pinch) - with the RGB channels split radially toward the corners, exactly like a real wide-angle or anamorphic lens. The frame gains glassy depth and a cinematic fringe at the edges.",
      "notForUseWhen": "flat editorial type, accessibility-critical text",
      "pairsPrototypes": [
        "aesthetic-cyberpunk",
        "recipe-bento-marketing",
        "aesthetic-frutiger-aero"
      ],
      "sourceFile": "design-library/shader-lens-distortion.md"
    },
    "luminance-particles": {
      "name": "Luminance Particles (image dissolves into glowing motes)",
      "category": "image-effect",
      "family": "filter",
      "defaultBlend": "add",
      "animated": "yes",
      "needsSource": "yes",
      "stackable": "yes",
      "subCategory": "particle",
      "role": "overlay",
      "roleAffinity": [
        "overlay"
      ],
      "oneLine": "An image or text layer sampled into a particle field, where each particle's brightness, size and drift come from the underlying luminance - bright areas bloom into dense glowing motes, dark areas fall to dust. The picture re-assembles out of light.",
      "notForUseWhen": "crisp product shots that must stay legible",
      "pairsPrototypes": [
        "aesthetic-luxury-cinematic-dark",
        "aesthetic-cosmic-horizon",
        "aesthetic-bioluminescent-deep"
      ],
      "sourceFile": "design-library/shader-luminance-particles.md"
    },
    "magnetic-field": {
      "name": "Magnetic Field (curl flow-field streamlines)",
      "category": "generative-fill",
      "family": "source",
      "defaultBlend": "add",
      "animated": "yes",
      "needsSource": "no",
      "stackable": "yes",
      "subCategory": "flow-field",
      "role": "background",
      "roleAffinity": [
        "background"
