# OS / editor junk
.DS_Store

# Python
__pycache__/
*.pyc

# Trash / scratch
.trash/
**/.trash/

# Draft-mode working files, written by the canvas-frames node's Draft button.
# The page CLONE is a dot-prefixed sibling of the page it clones (same directory,
# so the page's relative CSS / JS / images still resolve); the apply artefacts
# (annotated raster + note payload) live in .drafts/. Both dot-prefixed forms are
# also skipped by hosted-share snapshots and the daemon's file watcher.
**/.draft-*.html
**/.drafts/

# Local machine-specific Claude settings
.claude/settings.local.json

# Daemon-managed sanitised CODEX_HOME - built on first codex spawn from
# the user's ~/.codex/ minus skills/. Contents are symlinks; never commit.
.codex-home/

# Daemon-managed opencode config (mcp-config.json translated to opencode's
# shape, pointed at via OPENCODE_CONFIG on opencode spawns). Generated.
# The -chat variant is the main-chat spawn's visual-deny copy.
.opencode-config.json
.opencode-config-chat.json

# Vendored figma-cli (external MIT tool; install per editor/tools/figma-bridge/USING-FIGMA-CLI.md)
editor/tools/figma-cli/
Woven-v*.zip
