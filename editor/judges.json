{
  "_readme": [
    "Typed-judgment providers: one row per judge, read by editor/typed_judge.py.",
    "Plan and sources: docs/features/typed-judgment-providers.md (Reference: provider tiers).",
    "  wire           systemone (Jev, Clef, Local Clef) or openai-decisions (translated both ways)",
    "  config         the media-config.json / _PROVIDER_ENV_KEYS id that holds this judge's key",
    "  url            {account_id} is filled from media-config <config>.account_id",
    "  unwrap         reply object nested under this key (Cloudflare REST puts it in `result`)",
    "  imageEncoding  data-uri or base64: how each image goes on the wire",
    "  maxImages      0 = cannot read images; null = not published (not enforced locally)",
    "  autoRank       order the Auto choice tries keyed judges in, per tier; null = never auto-picked",
    "  idPattern      question ids the service accepts; maxImageBytesTotal: decoded bytes across all images",
    "A null cap is NOT enforced locally; the API's own 4xx comes back as a 400.",
    "When TypeSafe ships image input: raise maxImages on the jev row. The next Test on its",
    "key row verifies it and Jev joins the image tier at its autoRank. Nothing else changes."
  ],
  "providers": [
    {
      "id": "jev",
      "name": "TypeSafe Jev",
      "wire": "systemone",
      "config": "typesafe",
      "url": "https://api.typesafe.ai/v1/systemone",
      "model": "jev-latest",
      "maxImages": 0,
      "maxQuestions": null,
      "maxChoiceOptions": 255,
      "maxScoreLevels": 10,
      "contextTokens": 64000,
      "usdPerMInput": 0.042,
      "autoRank": {"text": 1, "image": 5}
    },
    {
      "id": "clef",
      "name": "Cloudflare Clef",
      "wire": "systemone",
      "config": "cloudflare",
      "url": "https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/run/@cf/cloudflare/clef",
      "unwrap": "result",
      "imageEncoding": "data-uri",
      "model": "clef",
      "maxImages": 4,
      "maxImageBytesTotal": 8388608,
      "maxQuestions": 64,
      "idPattern": "^[A-Za-z0-9_.-]{1,100}$",
      "maxChoiceOptions": 255,
      "maxScoreLevels": 10,
      "contextTokens": 65536,
      "contextIncludesImages": true,
      "usdPerMInput": 0.24,
      "autoRank": {"text": 3, "image": 1}
    },
    {
      "id": "clef-flash",
      "name": "Cloudflare Clef Flash",
      "wire": "systemone",
      "config": "cloudflare",
      "url": "https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/run/@cf/cloudflare/clef-flash",
      "unwrap": "result",
      "imageEncoding": "data-uri",
      "model": "clef-flash",
      "maxImages": 4,
      "maxImageBytesTotal": 8388608,
      "maxQuestions": 64,
      "idPattern": "^[A-Za-z0-9_.-]{1,100}$",
      "maxChoiceOptions": 255,
      "maxScoreLevels": 10,
      "contextTokens": 24576,
      "contextIncludesImages": true,
      "usdPerMInput": 0.038,
      "autoRank": {"text": 2, "image": 2}
    },
    {
      "id": "clef-local",
      "name": "Local Clef",
      "wire": "systemone",
      "config": "clef_local",
      "keyless": true,
      "url": "http://localhost:11434/v1/systemone",
      "imageEncoding": "base64",
      "model": "clef",
      "maxImages": 4,
      "imagesUnverified": true,
      "maxQuestions": 64,
      "maxChoiceOptions": 26,
      "maxScoreLevels": 26,
      "contextTokens": null,
      "usdPerMInput": 0,
      "autoRank": {"text": 5, "image": 4}
    },
    {
      "id": "openai",
      "name": "OpenAI Decisions",
      "wire": "openai-decisions",
      "config": "openai",
      "url": "https://api.openai.com/v1/decisions",
      "model": "gpt-6-luna",
      "maxImages": null,
      "maxQuestions": null,
      "maxChoiceOptions": 255,
      "maxScoreLevels": null,
      "contextTokens": null,
      "usdPerMInput": 0.1,
      "autoRank": {"text": 4, "image": 3}
    }
  ]
}
