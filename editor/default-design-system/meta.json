  "styles": [
    { "id": "default", "label": "Default", "attr": "", "desc": "The base light style - restrained institutional product UI." },
    { "id": "dark", "label": "Dark", "attr": "data-theme=\"dark\"", "desc": "Dark scheme - remapped surfaces/text/brand roles." },
    { "id": "minimal", "label": "Minimal", "attr": "data-theme=\"minimal\"", "file": "themes/minimal.css", "desc": "Light/white nav, primary-only palette, flat hairline elevation." },
    { "id": "pastel", "label": "Pastel", "attr": "data-theme=\"pastel\"", "file": "themes/pastel.css", "desc": "Soft pastel palette, pastel nav, no bold fills, no gradients." },
    { "id": "glassmorphism", "label": "Glassmorphism", "attr": "data-theme=\"glassmorphism\"", "file": "themes/glassmorphism.css", "desc": "iOS liquid-glass: translucent backdrop-blur surfaces + dispersion-prism edge accent." },
    { "id": "claymorphism", "label": "Claymorphism", "attr": "data-theme=\"claymorphism\"", "file": "themes/claymorphism.css", "desc": "Soft-UI foam: chunky radii, puffy dual drop+inset clay shadows." },
    { "id": "neumorphism", "label": "Neumorphism", "attr": "data-theme=\"neumorphism\"", "file": "themes/neumorphism.css", "desc": "Soft UI: single base colour, extruded dual shadow raised/pressed, monochrome." },
    { "id": "techminimalism", "label": "Tech-minimalism", "attr": "data-theme=\"techminimalism\"", "file": "themes/techminimalism.css", "desc": "Frutiger-DORFic / Teenage Engineering: concrete grey, single safety-orange, mono micro-labels, hairlines." },
    { "id": "neobrutalism", "label": "Neobrutalism", "attr": "data-theme=\"neobrutalism\"", "file": "themes/neobrutalism.css", "desc": "Monochrome editorial: cream paper, ink borders, zero radius, zero-blur offset shadow." },
    { "id": "analog", "label": "Analog", "attr": "data-theme=\"analog\"", "file": "themes/analog.css", "desc": "Ink-on-paper halftone: light surfaces with a live per-element halftone gradient (analog.js) on nav, filled cards and buttons." },
    { "id": "rams", "label": "Rams", "attr": "data-theme=\"rams\"", "file": "themes/rams.css", "desc": "Elegant Dieter Rams / Braun skeuomorphism: warm-grey device face, subtle top-down gradients + hairline bevels, recessed-well + raised-key controls that depress on press." },
    { "id": "slice9", "label": "Slice-9 game UI", "attr": "data-theme=\"slice9\"", "file": "themes/slice9.css", "desc": "Raster-backed 9-slice (border-image) game chrome: a generated frame atlas (assets/slice9/<id>/*.png from tools/slice9-gen.py) bound to .card/.btn/.input - zero render-time JS, resolution-independent corners. Library: aesthetic-8-bit-generic." }
  ],
